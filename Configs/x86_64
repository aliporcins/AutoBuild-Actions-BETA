# OpenWrt 25.12 / x86_64 / generic -- seed .config for aliporcins/AutoBuild-Actions-BETA
# Package set aligned with production VM100 (2026-11-01 inventory) + WireGuard trio.
# Generated against the target tree by `make defconfig` in the workflow; no credentials
# baked in; default address stays 192.168.1.1 (NOT the production 192.168.2.1).
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# PVE virtual NICs: production VM100 uses PCI-passthrough NICs (exclusive to it),
# so the Phase 1 test VM can only use virtual NICs -- virtio drivers must be in.
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-pci=y

# eBPF toolchain: use the HOST clang (apt-installed clang 14 on the runner,
# minimum required 12). Without an explicit choice, defconfig leaves the
# BPF_TOOLCHAIN choice unset (its PREBUILT default needs a llvm-bpf checkout
# that a fresh clone lacks, and BUILD only fires if NEED_BPF_TOOLCHAIN is
# selected), so bpf.mk falls back to /invalid/clang and bpf-headers fails.
# This line is the fix for run 41278525198 (bpf-headers: "LLVM/clang
# version too old ... found: " with /invalid/clang). It also avoids the
# hours-long from-source LLVM build that USE_LLVM_BUILD would trigger.
CONFIG_BPF_TOOLCHAIN_HOST=y

# Base: LuCI + Chinese packs + tun
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dhcp-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y

# NEW: WireGuard trio
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# Official feeds
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_cloudflared=y

# External packages (cloned at pinned commits by Scripts/AutoBuild_DiyScript.sh)
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-ota=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# Vendored in this repo under package/ (user's own package, read-only upstream)
CONFIG_PACKAGE_luci-app-totp=y

# Kernel BTF for dae/daed CO-RE: daed's BTF choice defaults to
# DAED_USE_KERNEL_BTF but depends on KERNEL_DEBUG_INFO_BTF; without it the
# choice falls to DAED_USE_VMLINUX_BTF and run 9 died at package/install
# on `vmlinux-btf (no such package)`. With this on, daed uses the
# kernel's integrated BTF and no vmlinux-btf package is needed.
# (pahole for BTF generation comes from the workflow's dwarves install.)
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# DEBUG_INFO_REDUCED 在 OpenWrt Config-kernel.in 里默认就是 y，而 DEBUG_INFO_BTF 依赖 !REDUCED；不显式关掉它，defconfig 会静默丢 BTF。
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

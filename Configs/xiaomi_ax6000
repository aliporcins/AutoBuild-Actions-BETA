# OpenWrt 25.12 / qualcommax ipq50xx / xiaomi_ax6000 -- seed .config for aliporcins/AutoBuild-Actions-BETA
# Xiaomi AX6000 (RA72, IPQ5018) with daed + luci-app-openclash.
# Built from official openwrt-25.12 source (xiaomi_ax6000 supported since 25.12.0).
# No credentials baked in; default address stays 192.168.1.1 (NOT any production address).
# Target outputs: openwrt-*-qualcommax-ipq50xx-xiaomi_ax6000-initramfs-factory.ubi
# (temporary firmware for xmir-patcher) + *-squashfs-sysupgrade.bin (official firmware).
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_ax6000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# eBPF toolchain: use the HOST clang (same fix as the x86_64 config;
# dae needs eBPF, and without an explicit choice defconfig leaves the
# BPF_TOOLCHAIN choice unset and bpf-headers fails).
CONFIG_BPF_TOOLCHAIN_HOST=y

# Base: LuCI + Chinese packs + tun
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dhcp-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y

# WireGuard trio
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# Scheduler kmods for dae traffic control: NET_SCH_INGRESS / NET_CLS_BPF /
# NET_CLS_ACT are provided by these (daed's DEPENDS pulls them in too, but
# select explicitly so defconfig enables the kernel options).
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y

# Official feeds
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_cloudflared=y

# External packages (cloned at pinned commits by Scripts/AutoBuild_DiyScript.sh)
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-ota=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# Vendored in this repo under package/ (user's own package, read-only upstream)
CONFIG_PACKAGE_luci-app-totp=y

# Kernel BTF for dae/daed CO-RE (same as the x86_64 config): daed's BTF
# choice defaults to DAED_USE_KERNEL_BTF but depends on KERNEL_DEBUG_INFO_BTF;
# without it the choice falls to DAED_USE_VMLINUX_BTF and the build dies at
# package/install on `vmlinux-btf (no such package)`.
# (pahole for BTF generation comes from the workflow's dwarves install.)
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# DEBUG_INFO_REDUCED is off by default in OpenWrt Config-kernel.in, and
# DEBUG_INFO_BTF depends on !REDUCED; keep it explicitly off so defconfig
# cannot silently drop BTF.
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_CGROUP_BPF=y

# Extra kernel options dae needs (bool options -- no package pulls these in,
# so they must be set explicitly; see DAED-FEASIBILITY.md section 1).
# The stock qualcommax/ipq50xx target config leaves all of these off.
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_XDP_SOCKETS=y

# OpenWrt NSS (kuncy7/openwrt-nss-edma, kernel 6.18) / qualcommax ipq50xx / xiaomi_ax6000 -- seed .config for aliporcins/AutoBuild-Actions-BETA
# Xiaomi AX6000 (RA72, IPQ5018) NSS test build: daed + luci-app-openclash + NSS hardware offload.
# Built from kuncy7/openwrt-nss-edma branch c3po-tag-8021q (OpenWrt main 2026-10-09 + kernel 6.18 + NSS).
# Parallel to the OpenWrt 25.12 fourth build (Configs/xiaomi_ax6000): this file and its
# workflow (AutoBuild-xiaomi_ax6000_nss.yml) are independent -- the 25.12 build is untouched.
# The workflow also reverts the tree's debug commit (MAGIC_SYSRQ_SERIAL/DEVMEM) before building.
# No credentials baked in; default address stays 192.168.1.1 (NOT any production address).
# Target outputs: openwrt-*-qualcommax-ipq50xx-xiaomi_ax6000-initramfs-factory.ubi
# (temporary firmware for xmir-patcher) + *-squashfs-sysupgrade.bin (official firmware).
# NOTE: start from this fresh .config -- do NOT reuse an old .config that still has
# CONFIG_PACKAGE_ath11k-firmware-ipq5018=y (the 2.4 GHz radio will not come up).
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_ax6000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# eBPF toolchain: use the HOST clang (same fix as the x86_64 config;
# dae needs eBPF, and without an explicit choice defconfig leaves the
# BPF_TOOLCHAIN choice unset and bpf-headers fails).
CONFIG_BPF_TOOLCHAIN_HOST=y

# Base: LuCI + Chinese packs + tun
CONFIG_PACKAGE_luci=y
# NOTE (2026-11-18,合一版): the luci-i18n-* packages are only generated
# when the language itself is enabled (luci.mk builds LuciTranslation
# packages only for LUCI_LANG_<lang> that is set); without
# CONFIG_LUCI_LANG_zh_Hans=y, `make defconfig` silently drops the
# package lines below (run 44179668449 + 44237725082 both shipped with
# 0 i18n packages). zh_Hans maps to the zh-cn package suffix.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# luci-i18n-dhcp-zh-cn does NOT exist upstream (no dhcp.po anywhere in
# openwrt/luci; luci-mod-network has no po/ dir), so it can never be
# selected -- the line was dead config, dropped every build. DHCP/DNS
# pages stay English until upstream adds translations. (AX3000T side
# confirmed the same: dhcp-zh-cn is absent from every feed.)
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y

# WireGuard removed 2026-11-19 (user decision: not wanted on AX6000).
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set

# Scheduler kmods for dae traffic control: NET_SCH_INGRESS / NET_CLS_BPF /
# NET_CLS_ACT are provided by these (daed's DEPENDS pulls them in too, but
# select explicitly so defconfig enables the kernel options).
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y

# Official feeds
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
# nginx-ssl removed 2026-11-18 (user-approved first-tier cleanup; unused on AX6000).
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-filemanager=y
# Traffic monitor (added 2026-11-20, user request; scheme B same as x86_64):
# nlbwmon only (official feed). It counts via conntrack, so software
# flow offloading does NOT affect it. wrtbwmon was considered and
# REJECTED: it counts via iptables, which goes blind under flow
# offloading. luci-lib-chartjs is the chart library luci-app-nlbwmon
# renders with; luci-i18n-nlbwmon-zh-cn rides on the zh_Hans switch.
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-lib-chartjs=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# CONFIG_PACKAGE_cloudflared is not set (removed 2026-11-19, user decision: room for OpenClash Meta core)

# mDNS responder (added 2026-11-18, user request: ax6000.local out of the box).
# umdns ships its own default /etc/config/umdns (list network lan) which
# announces the system hostname on lan; the workflow's Tempoary_HOSTNAME
# block sets hostname=ax6000 at build time, so no manual step is needed
# after flashing. Android devices do not resolve .local (no mDNS client).
CONFIG_PACKAGE_umdns=y

# Wake-on-LAN (added 2026-11-13, user request; only these two packages).
# etherwake (packages feed) sends magic packets from the command line;
# luci-app-wol (luci feed) provides the LuCI web UI (depends on etherwake).
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y

# No USB on AX6000 hardware (2026-11-18, user-confirmed: no USB port;
# USB 3.0 is on AX9000, not AX6000). kmod-usb-storage + block-mount
# were added in the merged build but removed again the same day --
# nothing can be plugged in. luci-app-diskman was removed 2026-11-18
# (user-approved first-tier cleanup; no drives to manage); filemanager
# stays (a separate audit is deciding whether it has other uses on a
# USB-less box); neither depends on or selects block-mount (verified
# against their Makefiles), so removing these lines cannot drop them.
# Target-tree defaults disabled (2026-11-18, user-approved first-tier
# cleanup; AX6000 has no USB port and no local storage to mount):
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_losetup is not set

# External packages (cloned at pinned commits by Scripts/AutoBuild_DiyScript.sh)
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-lucky is not set (removed 2026-11-19, user decision: room for OpenClash Meta core)
# CONFIG_PACKAGE_lucky is not set (removed 2026-11-19, user decision: room for OpenClash Meta core)
# luci-app-diskman removed 2026-11-18 (user-approved first-tier cleanup;
# no USB port, no drives to manage on AX6000).
CONFIG_PACKAGE_luci-app-ramfree=y
# CONFIG_PACKAGE_luci-app-ota is not set (removed 2026-11-19, user decision)
CONFIG_PACKAGE_luci-app-autoreboot=y

# CONFIG_PACKAGE_luci-app-totp is not set (removed 2026-11-19, user decision; vendored package still in repo under package/luci-app-totp/ but no longer copied or selected)

# Kernel BTF for dae/daed CO-RE (same as the x86_64 config): daed's BTF
# choice defaults to DAED_USE_KERNEL_BTF but depends on KERNEL_DEBUG_INFO_BTF;
# without it the choice falls to DAED_USE_VMLINUX_BTF and the build dies at
# package/install on `vmlinux-btf (no such package)`.
# (pahole for BTF generation comes from the workflow's dwarves install.)
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# DEBUG_INFO_REDUCED is off by default in OpenWrt Config-kernel.in, and
# DEBUG_INFO_BTF depends on !REDUCED; keep it explicitly off so defconfig
# cannot silently drop BTF.
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_CGROUP_BPF=y

# Extra kernel options dae needs (bool options -- no package pulls these in,
# so they must be set explicitly; see DAED-FEASIBILITY.md section 1).
# The stock qualcommax/ipq50xx target config leaves all of these off.
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_XDP_SOCKETS=y

# --- NSS hardware offload (kuncy7/openwrt-nss-edma, README.ipq50xx.md) ---
# nss-tools-dwmac MUST be =y (not =m): it pulls in every kmod the plane needs
# and is the package that actually arms the firmware. =m builds it but leaves
# it out of the image, and the plane never comes up.
CONFIG_PACKAGE_nss-tools-dwmac=y
# NSS firmware 12.5-210 (feed default); 12.2-156 also works but build for the
# version you run (Wi-Fi peer stats layout differs).
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# AX6000 has 512MB RAM: MEDIUM (std) memory profile.
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# qca-nss-drv features the plane uses
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
# PPPoE: the kernel side builds, but ECM only accelerates PPPoE when the
# connection manager is present -- without it flows are tracked and never
# offloaded, with nothing in the log to say so.
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
# ath11k with the NSS patches (Wi-Fi offload); the validated combination for
# the wired plane as well.
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
# NSS diagnostics (from the tree's CI config): netlink interface + nssinfo tool.
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# ath11k firmware: WLAN.HK.2.7.0.1 (ath11k-firmware-ipq5018-qcn6122).
# Do NOT use the stock 2.9.r4 blob: on this driver it makes the internal
# 2.4 GHz radio's Q6 assert (PHY0M3) ~13 minutes after the BSS comes up.
# The tree's xiaomi_ax6000 DEVICE_PACKAGES already defaults to -qcn6122
# (the old ath11k-firmware-ipq5018 package does not exist in this tree);
# set it explicitly so the choice is visible in the diffconfig.
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y

# ath10k (QCA9887, third 5 GHz radio) -- STANDARD firmware, NOT CT
# (2026-11-20, user decision: switch CT -> standard; the SWBA-overrun
# hardware-restart issue is a known CT-firmware behaviour, and the
# standard 10.2.4 firmware is reported more stable for plain AP use).
# The tree's xiaomi_ax6000 DEVICE_PACKAGES defaults to the CT pair
# (kmod-ath10k-ct-smallbuffers + ath10k-firmware-qca9887-ct); these
# lines explicitly deselect CT and select the standard pair instead.
# kmod-ath10k-smallbuffers is the standard driver's low-RAM variant
# (same small-buffers role as the CT one, so no memory is lost).
# CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers is not set
# CONFIG_PACKAGE_ath10k-firmware-qca9887-ct is not set
CONFIG_PACKAGE_kmod-ath10k-smallbuffers=y
CONFIG_PACKAGE_ath10k-firmware-qca9887=y

#!/bin/sh
# pbr custom user file: China IPv4 list -> wan user destination set.
# 2026-11-21, Xiaomi AX6000 split tunnel (China direct, foreign via warp).
# Mirrors the shipped pbr.user.aws pattern (same shell-script mechanism):
# on every pbr start/reload, download the China CIDR list and add it
# to the wan interface's nft user set (pbr_wan_4_dst_ip_user). pbr
# creates that set (empty) before running this file and emits its match
# rule in pbr_prerouting ahead of the policy rules, so China
# destinations go via wan while the catch-all policy sends the rest
# via warp. If the download fails (offline at boot, list moved), return
# 1 without breaking pbr: the set stays empty, traffic then follows the
# warp policy, and with warp disabled it falls back to the default
# route. The failure shows in `service pbr status` / logread as
# errorUserFileRunning for this path.
# NOTE: this MUST stay a shell script. pbr 1.2.2 (what the feeds ship)
# is the shell implementation -- it syntax-checks this file with ash
# and sources it with an nft() capture wrapper. A .uc (ucode) file
# only works on pbr 1.2.3+; a .uc here fails the ash syntax check and
# the China set stays empty (first shipped as .uc, caught in verify).
# shellcheck disable=SC2015,SC3003,SC3060
TARGET_URL='https://raw.githubusercontent.com/17mon/china_ip_list/master/china_ip_list.txt'
TARGET_DL_FILE='/var/pbr_tmp_china_ip_list.txt'
TARGET_TABLE='inet fw4'
TARGET_INTERFACE='wan'

_ret=1

mkdir -p "${TARGET_DL_FILE%/*}"

[ -s "$TARGET_DL_FILE" ] || \
	uclient-fetch --no-check-certificate -qO- "$TARGET_URL" > "$TARGET_DL_FILE" 2>/dev/null

[ -s "$TARGET_DL_FILE" ] || return 1

chunk=''
n=0
while IFS= read -r line; do
	case "$line" in ''|'#'*) continue;; esac
	if [ -z "$chunk" ]; then chunk="$line"; else chunk="$chunk, $line"; fi
	n=$((n+1))
	if [ "$n" -ge 200 ]; then
		nft "add element $TARGET_TABLE pbr_${TARGET_INTERFACE}_4_dst_ip_user { $chunk }" && _ret=0 || _ret=1
		chunk=''
		n=0
	fi
done < "$TARGET_DL_FILE"
[ -n "$chunk" ] && { nft "add element $TARGET_TABLE pbr_${TARGET_INTERFACE}_4_dst_ip_user { $chunk }" && _ret=0 || _ret=1; }

return $_ret
